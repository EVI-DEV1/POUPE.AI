# Chave da API do Google Gemini — usada SOMENTE no servidor (/api/gemini).
# Não use o prefixo VITE_: variáveis VITE_* são embutidas no bundle público.
GEMINI_API_KEY=

# Opcionais — proteção contra abuso de /api/gemini (limites por IP, por instância).
# GEMINI_RATE_LIMIT_PER_MINUTE=10
# GEMINI_RATE_LIMIT_PER_HOUR=60
# Domínios extras autorizados a chamar a API (o próprio domínio já é aceito).
# ALLOWED_ORIGINS=https://www.seudominio.com.br
